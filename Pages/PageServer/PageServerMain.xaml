<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageServerMain"
    PanScroll="Content">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="Content">
        <StackPanel x:Name="PanRoot" Margin="24,24,24,24">

            <!-- ===== 0. 服务端列表 ===== -->
            <StackPanel x:Name="PanSecVersions">
                <local:MyCard Title="本地服务端" Margin="0,0,0,20">
                    <StackPanel Margin="24,40,24,24">
                        <TextBlock x:Name="LabLocalSummary" TextWrapping="Wrap" Text="正在扫描……" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <local:MyButton x:Name="BtnServerRescan" Text="重新扫描" Height="32" MinWidth="100" />
                            <local:MyButton x:Name="BtnServerFolder" Text="打开目录" Height="32" MinWidth="100" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Text="每个服务端版本有独立目录与世界存档，互不干扰。&#xa;还没有服务端？到左侧「下载核心」按用途挑一个。" />
                    </StackPanel>
                </local:MyCard>
                <StackPanel x:Name="PanServerList" />
                <local:MyCard x:Name="PanServerEmpty" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel x:Name="PanServerEmptyInner" Margin="24,32,24,24" />
                </local:MyCard>
            </StackPanel>

            <!-- ===== 向导（简幻欢式）：左竖向时间线 + 右内容 + 右下角 返回/继续 ===== -->
            <StackPanel x:Name="PanSecDownload" Visibility="Collapsed">
                <!-- Java 前置提示 -->
                <local:MyCard x:Name="PanJavaHint" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel Margin="24,24,24,24">
                        <TextBlock x:Name="LabJavaHint" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <local:MyButton x:Name="BtnJavaRetry" Text="重新检测" Height="30" MinWidth="100" />
                            <local:MyButton x:Name="BtnJavaInstall" Text="一键安装 Java 17" Height="30" MinWidth="130" Margin="12,0,0,0"
                                            ToolTip="自动下载并安装 Eclipse Temurin JRE 17。需要联网，约 40 MB。" />
                            <local:MyButton x:Name="BtnJavaGoSetup" Text="去设置里配置" Height="30" MinWidth="120" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="PanStepCard" Margin="0,0,0,20">
                    <Grid Margin="12,24,24,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：竖向时间线（VB 动态构建节点） -->
                        <StackPanel x:Name="PanStepRail" Grid.Column="0" Margin="4,8,20,8" />

                        <!-- 右：内容宿主，五个步骤卡叠放，一次只露一个 -->
                        <Grid x:Name="PanStepHost" Grid.Column="1" ClipToBounds="True">
                            <local:MyCard x:Name="CardStep1" UseAnimation="False" Title="选择实例类别" Margin="0" VerticalAlignment="Top">
                                <StackPanel Margin="20,40,20,20">
                                    <StackPanel x:Name="PanCatList" />
                                    <TextBlock x:Name="LabCatHint" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Text="类别决定后面能选哪些服务端。未支持的类别会灰显。"/>
                                </StackPanel>
                            </local:MyCard>

                            <local:MyCard x:Name="CardStep2" UseAnimation="False" Title="选择实例服务端" Margin="0" VerticalAlignment="Top" Visibility="Collapsed">
                                <StackPanel Margin="20,40,20,20">
                                    <TextBlock x:Name="LabCoreStatus" TextWrapping="Wrap" Text="正在获取服务端列表……" />
                                    <StackPanel x:Name="PanCoreList" Margin="0,14,0,0" />
                                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Text="数据来自 FastMirror 镜像。描述里标了每种核心能装什么。"/>
                                </StackPanel>
                            </local:MyCard>

                            <local:MyCard x:Name="CardStep3" UseAnimation="False" Title="选择实例版本" Margin="0" VerticalAlignment="Top" Visibility="Collapsed">
                                <StackPanel Margin="20,40,20,20">
                                    <TextBlock x:Name="LabVersionStatus" TextWrapping="Wrap" Text="选一个游戏版本。" />
                                    <StackPanel x:Name="PanVersionList" Margin="0,14,0,0" />
                                    <TextBlock x:Name="LabBuildStatus" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}" />
                                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Text="核心 jar 会在「确认并创建」时才下载，这里只做选择。"/>
                                </StackPanel>
                            </local:MyCard>

                            <local:MyCard x:Name="CardStep4" UseAnimation="False" Title="选择实例规格" Margin="0" VerticalAlignment="Top" Visibility="Collapsed">
                                <StackPanel Margin="20,40,20,20">
                                    <TextBlock TextWrapping="Wrap" Text="按玩家人数和整合包大小挑内存。拿不准就选 2048 MB。" />
                                    <StackPanel x:Name="PanSpecList" Margin="0,14,0,0" />
                                </StackPanel>
                            </local:MyCard>

                            <local:MyCard x:Name="CardStep5" UseAnimation="False" Title="确认信息并创建" Margin="0" VerticalAlignment="Top" Visibility="Collapsed">
                                <StackPanel Margin="20,40,20,20">
                                    <TextBlock x:Name="LabSummary" TextWrapping="Wrap" />
                                    <!-- 创建进度：真实字节比例 -->
                                    <StackPanel x:Name="PanDownloadProgress" Margin="0,16,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="LabProgressText" Margin="0,0,0,6" />
                                        <Grid Height="8">
                                            <Border Background="{DynamicResource ColorBrushGray1}" CornerRadius="4" />
                                            <Border x:Name="BarDownload" Background="{DynamicResource ColorBrush3}"
                                                    CornerRadius="4" HorizontalAlignment="Left" Width="0" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="LabCreateStatus" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}" />
                                </StackPanel>
                            </local:MyCard>
                        </Grid>
                    </Grid>
                </local:MyCard>

                <!-- 右下角导航：返回(link 风格) + 主按钮；按钮常驻只切状态 -->
                <Grid Margin="0,0,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:MyTextButton x:Name="BtnWizardPrev" Grid.Column="0" Text="返回上一步"
                                        HorizontalAlignment="Right" Margin="0,0,16,0" Visibility="Collapsed" />
                    <local:MyButton x:Name="BtnWizardNext" Grid.Column="1" Text="继续"
                                    Height="34" MinWidth="120" ColorType="Highlight" />
                </Grid>
            </StackPanel>


            <!-- ===== 2. 控制台 ===== -->
            <StackPanel x:Name="PanSecConsole" Visibility="Collapsed">
                <local:MyCard Title="服务器控制台" Margin="0,0,0,20">
                    <StackPanel Margin="24,40,24,24">
                        <TextBlock x:Name="LabConsoleStatus" TextWrapping="Wrap" Text="当前没有运行中的服务器。" />
                        <local:MyTextBox x:Name="TextConsoleCommand" Height="32" Margin="0,16,0,0"
                                         HintText="输入命令并回车发送，例如 say 你好 或 list" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <local:MyButton x:Name="BtnConsoleSend" Text="发送" Height="30" MinWidth="80" />
                            <local:MyButton x:Name="BtnConsoleStop" Text="停止服务器" Height="30" MinWidth="110" Margin="12,0,0,0" />
                            <local:MyButton x:Name="BtnConsoleClear" Text="清空输出" Height="30" MinWidth="90" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Title="托管外部服务器" Margin="0,0,0,20">
                    <StackPanel Margin="24,40,24,24">
                        <TextBlock x:Name="LabAttachStatus" TextWrapping="Wrap"
                                   Text="别的窗口或脚本启动的服务器，这里也能接过来管。点「自动搜索」找运行中的 java 服务端。"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <local:MyComboBox x:Name="ComboAttach" Height="30" MinWidth="300"
                                              ToolTip="自动搜索到的运行中服务端进程"/>
                            <local:MyButton x:Name="BtnAttachScan" Text="自动搜索" Height="30" MinWidth="90" Margin="12,0,0,0"/>
                            <local:MyButton x:Name="BtnAttachConnect" Text="附加" Height="30" MinWidth="70" Margin="12,0,0,0"/>
                            <local:MyButton x:Name="BtnAttachDetach" Text="断开" Height="30" MinWidth="70" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Text="命令通过 RCON 发送（需要服务器开启 enable-rcon），输出跟踪 logs\latest.log。未开 RCON 时只能看日志，卡片会告诉你怎么开。"/>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Title="输出" Margin="0,0,0,20">
                    <ScrollViewer x:Name="ScrollConsole" Margin="20,32,20,16" Height="340"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TextConsoleOutput" TextWrapping="Wrap" FontFamily="Consolas"
                                   FontSize="{StaticResource Font.Body}" Text="" />
                    </ScrollViewer>
                </local:MyCard>
            </StackPanel>

            <!-- ===== 3. 状态 ===== -->
            <StackPanel x:Name="PanSecStatus" Visibility="Collapsed">
                <local:MyCard Title="运行状态" Margin="0,0,0,20">
                    <StackPanel Margin="24,40,24,24">
                        <TextBlock x:Name="LabStatusSummary" TextWrapping="Wrap" Text="加载中……" />
                        <local:MyButton x:Name="BtnStatusRefresh" Text="刷新状态" Height="32" MinWidth="110"
                                        Margin="0,16,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </local:MyCard>
                <StackPanel x:Name="PanStatusDetail" />
            </StackPanel>

            <!-- ===== 4. 模板 ===== -->
            <StackPanel x:Name="PanSecTemplates" Visibility="Collapsed">
                <local:MyCard Title="快速模板" Margin="0,0,0,20">
                    <StackPanel Margin="24,40,24,24">
                        <TextBlock TextWrapping="Wrap"
                                   Text="按用途预先把内存与正版验证调好，创建后仍可单独修改。&#xa;模板只创建配置，服务端核心仍需在「下载核心」里下载。" />
                    </StackPanel>
                </local:MyCard>
                <StackPanel x:Name="PanTemplateList" />
            </StackPanel>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
