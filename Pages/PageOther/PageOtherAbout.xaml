                <!-- 鸣谢页头像统一外观：64x64 源图 -> 34x34 显示，圆形裁剪半径 17，UniformToFill 保证不拉伸 -->
                <Style x:Key="HeadAvatar" TargetType="Image">
                    <Setter Property="Width" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Margin" Value="3" />
                    <Setter Property="Stretch" Value="UniformToFill" />
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                    <Setter Property="Clip">
                        <Setter.Value>
                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <local:MyCard Margin="0,16" Title="关于">
                        <Grid Margin="20,40,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45" />
                                <RowDefinition Height="45" />
                                <RowDefinition Height="45" />
                                <RowDefinition Height="45" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <local:MyListItem IsHitTestVisible="False" Title="龙腾猫跃" Margin="-4,0,16,0" Info="Plain Craft Launcher 的开发者！" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Logo="/SLATCL;component/Images/Heads/LTCat.png" LogoScale="0.65" />
                            <local:MyListItem IsHitTestVisible="False" Title="HerobrineXia" Margin="-4,0,16,0" Info="Plain Craft Launcher 的协力开发者！" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
